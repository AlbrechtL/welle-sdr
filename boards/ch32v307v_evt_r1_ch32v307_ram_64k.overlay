#include <zephyr/dt-bindings/clock/ch32v20x_30x-clocks.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ch32v20x_30x-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	/*
	 * Console on USART2 (PA2 TX, PA3 RX), wired to the WCH-Link UART on J2
	 * pins 3 and 5. PA9/PA10 carry ADC data bits DB0/DB1.
	 */
	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
	};

	/*
	 * R820T2 tuner: SCL on PB10, SDA on PB11, bit-banged. The I2C2
	 * controller on these pins is not used, see the README.
	 */
	r820t2_i2c: r820t2-i2c {
		compatible = "gpio-i2c";
		scl-gpios = <&gpiob 10 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		sda-gpios = <&gpiob 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	soc {
		/* USBHS controller with built-in HS PHY on PB6 (DM) / PB7 (DP), connector P6 */
		zephyr_udc0: usbhs: usbd@40023400 {
			compatible = "wch,usbhs";
			reg = <0x40023400 0x400>;
			clocks = <&rcc CH32V20X_V30X_CLOCK_USBHS>;
			interrupt-parent = <&pfic>;
			interrupts = <85>;
			num-bidir-endpoints = <16>;
			maximum-speed = "high-speed";
			status = "okay";
		};

		/*
		 * AD9280 ADC module on the DVP, wiring variant B (see README):
		 * DCLK from TIM1_CH1 on PA8, jumper wires PA8-PA6 (PCLK),
		 * PA0-PA4 (HSYNC), PA1-PA5 (VSYNC).
		 */
		adc_dvp: dvp@50050000 {
			compatible = "wch,dvp-adc";
			reg = <0x50050000 0x24>;
			clocks = <&rcc CH32V20X_V30X_CLOCK_DVP>;
			interrupt-parent = <&pfic>;
			interrupts = <86>;
			pwms = <&pwm1 0 PWM_NSEC(125) PWM_POLARITY_NORMAL>;
			hsync-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			vsync-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			/* D0..D7, PCLK, HSYNC, VSYNC */
			input-gpios = <&gpioa 9 0>, <&gpioa 10 0>, <&gpioc 8 0>, <&gpioc 9 0>,
				      <&gpioc 11 0>, <&gpiob 3 0>, <&gpiob 8 0>, <&gpiob 9 0>,
				      <&gpioa 6 0>, <&gpioa 4 0>, <&gpioa 5 0>;
			status = "okay";
		};
	};
};

&pinctrl {
	usart2_default: usart2_default {
		group1 {
			pinmux = <USART2_TX_PA2_0>;
			output-high;
			drive-push-pull;
			slew-rate = "max-speed-10mhz";
		};

		group2 {
			pinmux = <USART2_RX_PA3_0>;
			bias-pull-up;
		};
	};

	tim1_pwm_default: tim1_pwm_default {
		group1 {
			pinmux = <TIM1_CH1_PA8_0>;
			output-high;
			drive-push-pull;
			slew-rate = "max-speed-50mhz";
		};
	};
};

/* ADC clock: TIM1 counts at the undivided 144 MHz, DCLK = 144 MHz / period */
&tim1 {
	prescaler = <0>;
	status = "okay";
};

&pwm1 {
	pinctrl-0 = <&tim1_pwm_default>;
	pinctrl-names = "default";
	status = "okay";
};

&usart2 {
	current-speed = <115200>;
	pinctrl-0 = <&usart2_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* PA9/PA10 are ADC data inputs (DB0/DB1) */
&usart1 {
	status = "disabled";
};

/* R7 is removed; PC8/PC9 are ADC data inputs (DB2/DB3) */
&mac {
	status = "disabled";
};

&mdio {
	status = "disabled";
};

/* LED1 shows the USB state; it needs a jumper wire from J3 LED1 to PD0 */
&{/leds} {
	status = "okay";
};
